---
// Dores (CLAUDE.md, seção 6.3): situações que o dono reconhece, em cartões com ícone.
// As frases 3 e 4 continuam de um cartão para o outro (reticências), e o último cartão fecha.
// Em telas largas os cinco cabem numa linha; abaixo disso viram uma trilha com rolagem
// horizontal e encaixe, que encosta nas bordas da tela (mesmo padrão dos serviços).
import { DORES, DORES_TITULO } from '../data/site';

// Ícones de linha, 24x24, no mesmo traço dos cartões de serviço.
const ICONES = {
  busca: '<circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5 21 21"/>',
  papel: '<path d="M6 3h9l4 4v14H6z"/><path d="M15 3v4h4"/><path d="M9 12h7M9 16h5"/>',
  relogio: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>',
  repeticao: '<path d="M4 11a7 7 0 0 1 12-5l2 2"/><path d="M18 3v5h-5"/><path d="M20 13a7 7 0 0 1-12 5l-2-2"/><path d="M6 21v-5h5"/>',
  dinheiro: '<circle cx="12" cy="12" r="8.5"/><path d="M14.8 9.3c-.5-.9-1.6-1.4-2.8-1.4-1.6 0-2.8.8-2.8 2s1.1 1.7 2.8 2.1 2.8.9 2.8 2.1-1.2 2-2.8 2c-1.3 0-2.4-.6-2.9-1.5M12 6.2v1.7M12 16.1v1.7"/>',
};
---

<section class="secao secao--nevoa dores" aria-labelledby="dores-titulo">
  <div class="pagina">
    <h2 id="dores-titulo" class="dores__titulo">{DORES_TITULO}</h2>
  </div>
  <ul class="dores__trilha" tabindex="0" aria-label="Situações comuns, role para o lado">
    {
      DORES.map((dor) => (
        <li class="dor">
          <span class="dor__icone" aria-hidden="true">
            <svg viewBox="0 0 24 24" focusable="false" set:html={ICONES[dor.icone]} />
          </span>
          <p class="dor__texto">{dor.texto}</p>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .dores {
    padding-block: clamp(3.5rem, 2.5rem + 4vw, 6rem);
  }

  .dores__titulo {
    font-size: var(--t-36);
    max-width: 20ch;
  }

  .dores__trilha {
    --respiro: max(var(--margem), calc((100% - var(--pagina)) / 2));
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1rem;
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
    padding-inline: var(--respiro);
  }

  .dor {
    display: grid;
    align-content: space-between;
    gap: 2rem;
    min-height: 14rem;
    padding: 1.4rem;
    border-radius: 1rem;
    background: var(--branco);
  }

  .dor__icone {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--nevoa);
    color: var(--cobalto);
  }

  .dor__icone svg {
    width: 1.35rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .dor__texto {
    font-size: 1.125rem;
    font-weight: var(--peso-medio);
    line-height: 1.4;
  }

  /* O último cartão fecha a sequência */
  .dor:last-child {
    background: var(--preto);
    color: var(--branco);
  }

  .dor:last-child .dor__icone {
    background: var(--cobalto);
    color: var(--branco);
  }

  .dores__trilha:focus-visible {
    outline-offset: -2px;
  }

  /* Abaixo de 1100px: trilha horizontal */
  @media (max-width: 1100px) {
    .dores__trilha {
      display: flex;
      padding-bottom: 0.75rem;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--respiro);
      scrollbar-width: thin;
      scrollbar-color: var(--linha) transparent;
    }

    .dor {
      flex: 0 0 min(72vw, 16rem);
      scroll-snap-align: start;
    }
  }
</style>
