---
// Fotos reais em src/assets/time/. Nunca gerar foto do time com IA (seção 5.1).
// No celular a lista vira uma trilha com rolagem horizontal (um sócio por vez, com o próximo aparecendo).
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { TIME } from '../data/site';

const fotos = import.meta.glob<{ default: ImageMetadata }>('/src/assets/time/*.{png,jpg,jpeg,webp}', {
  eager: true,
});
---

<section class="secao time" id="time" aria-labelledby="time-titulo">
  <div class="pagina">
    <h2 id="time-titulo" class="titulo-secao">Nosso time</h2>

    <ul class="time__lista" tabindex="0" aria-label="Sócios da WRF">
      {
        TIME.map((socio) => {
          const foto = fotos[`/src/assets/time/${socio.foto}`]?.default;
          return (
            <li class="socio">
              <div class="socio__foto">
                {foto ? (
                  <Picture
                    src={foto}
                    alt={socio.nome ? `Foto de ${socio.nome}` : `Foto do sócio de ${socio.area}`}
                    formats={['avif', 'webp']}
                    fallbackFormat="webp"
                    widths={[320, 480, 640]}
                    sizes="(min-width: 860px) 360px, 92vw"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <p class="socio__foto-pendente">Foto real pendente</p>
                )}
              </div>
              <p class="socio__area">{socio.area}</p>
              <h3 class="socio__nome">{socio.nome ?? socio.area}</h3>
              <p class="socio__descricao">{socio.descricao}</p>
              {socio.frase && <p class="socio__frase">{socio.frase}</p>}
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .time__lista {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2.5rem clamp(1.5rem, 3vw, 2.5rem);
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .socio {
    display: grid;
    gap: 0.6rem;
    align-content: start;
  }

  .socio__foto {
    aspect-ratio: 4 / 5;
    margin-bottom: 0.75rem;
    overflow: hidden;
    background: var(--nevoa);
    border-radius: var(--raio);
  }

  .socio__foto :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 25%;
  }

  .socio__foto-pendente {
    display: grid;
    place-items: center;
    height: 100%;
    color: var(--grafite);
    font-size: var(--t-pequeno);
  }

  .socio__area {
    color: var(--cobalto);
    font-weight: 700;
  }

  .socio__nome {
    font-size: var(--t-26);
  }

  .socio__descricao {
    color: var(--grafite);
    max-width: 36ch;
  }

  .socio__frase {
    margin-top: 0.5rem;
    padding-left: 0.9rem;
    border-left: 2px solid var(--cobalto);
    font-weight: var(--peso-medio);
    max-width: 36ch;
  }

  .time__lista:focus-visible {
    outline-offset: 6px;
  }

  /* Celular: trilha horizontal que encosta nas bordas da tela */
  @media (max-width: 860px) {
    .time__lista {
      display: flex;
      gap: 1.25rem;
      margin-inline: calc(var(--margem) * -1);
      padding: 0.25rem var(--margem) 1rem;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--margem);
      scrollbar-width: thin;
      scrollbar-color: var(--linha) transparent;
    }

    .socio {
      flex: 0 0 min(78vw, 20rem);
      scroll-snap-align: start;
    }
  }
</style>
