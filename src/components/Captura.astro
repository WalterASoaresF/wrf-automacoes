---
// Uma captura real do Casa do Dendê, ou uma moldura "captura pendente" se o arquivo
// ainda não estiver em src/assets/capturas/.
// As capturas reais já vêm recortadas rente ao aparelho (celular ou tablet), com canto
// arredondado transparente — sem o fundo (mesa, parede etc.) do arquivo original. Aqui só
// acrescentamos uma sombra, sem desenhar outra moldura por cima. As pendentes usam uma moldura
// de espaço reservado, no formato que a etapa vai ter.
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { CAPTURAS, type ChaveCaptura } from '../data/site';

interface Props {
  chave: ChaveCaptura;
  prioridade?: boolean;
  sizes?: string;
}
const { chave, prioridade = false, sizes } = Astro.props;
const captura = CAPTURAS[chave];

const arquivos = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/capturas/*.{png,jpg,jpeg,webp}',
  { eager: true },
);
const imagem = arquivos[`/src/assets/capturas/${captura.arquivo}`]?.default;

const larguras = captura.formato === 'celular' ? [220, 320, 440, 640] : [480, 720, 960, 1440];
const tamanhos =
  sizes ?? (captura.formato === 'celular' ? '(min-width: 900px) 260px, 60vw' : '(min-width: 900px) 560px, 92vw');
---

<figure class:list={['captura', `captura--${captura.formato}`, { 'captura--pendente': !imagem }]}>
  {
    imagem ? (
      <Picture
        class="captura__imagem"
        src={imagem}
        alt={captura.alt}
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        widths={larguras}
        sizes={tamanhos}
        loading={prioridade ? 'eager' : 'lazy'}
        fetchpriority={prioridade ? 'high' : 'auto'}
        decoding="async"
      />
    ) : (
      <div class="captura__pendente">
        <p class="captura__pendente-titulo">Captura pendente</p>
        <p class="captura__pendente-texto">{captura.alt}</p>
        <p class="captura__pendente-arquivo">src/assets/capturas/{captura.arquivo}</p>
      </div>
    )
  }
</figure>

<style>
  .captura {
    margin: 0;
  }

  .captura--celular {
    width: min(100%, 15rem);
  }

  .captura--tela {
    width: 100%;
    max-width: 34rem;
  }

  .captura__imagem {
    display: block;
    width: 100%;
    height: auto;
    /* O canto arredondado já vem recortado (transparente) na própria imagem, não precisa de
       border-radius aqui. A sombra usa "filter", que acompanha essa transparência, em vez de
       "box-shadow", que desenharia um retângulo fantasma atrás do canto arredondado. */
    /* Duas sombras: uma curta e mais escura (contato) e uma longa e difusa (profundidade). */
    filter: drop-shadow(0 0.25rem 0.4rem rgb(0 0 0 / 0.18)) drop-shadow(0 1.75rem 2.25rem rgb(0 0 0 / 0.28));
  }

  /* Sobre fundo preto a sombra escura some; no lugar dela, um halo claro e discreto
     destaca o contorno do aparelho. */
  :global(.secao--escura) .captura__imagem {
    filter: drop-shadow(0 0 1px rgb(255 255 255 / 0.35)) drop-shadow(0 1.5rem 3rem rgb(255 255 255 / 0.08));
  }

  .captura--pendente {
    width: 100%;
  }

  .captura--pendente.captura--celular {
    max-width: 15rem;
  }

  .captura__pendente {
    display: grid;
    align-content: center;
    gap: 0.6rem;
    height: 100%;
    padding: 1.25rem;
    color: var(--grafite);
    background: repeating-linear-gradient(-45deg, var(--nevoa) 0 12px, var(--branco) 12px 24px);
    border: 2px dashed var(--linha);
    border-radius: 0.75rem;
  }

  .captura--celular .captura__pendente {
    aspect-ratio: 9 / 19.5;
  }

  .captura--tela .captura__pendente {
    aspect-ratio: 4 / 3;
  }

  :global(.secao--escura) .captura__pendente {
    color: var(--linha);
    background: repeating-linear-gradient(-45deg, #111 0 12px, #000 12px 24px);
    border-color: var(--grafite);
  }

  .captura__pendente-titulo {
    color: var(--preto);
    font-weight: 700;
  }

  :global(.secao--escura) .captura__pendente-titulo {
    color: var(--branco);
  }

  .captura__pendente-texto {
    font-size: var(--t-pequeno);
    line-height: 1.45;
  }

  .captura__pendente-arquivo {
    font-size: 0.75rem;
    word-break: break-all;
  }
</style>
