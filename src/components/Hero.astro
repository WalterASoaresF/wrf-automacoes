---
import Ctas from './Ctas.astro';
import TextoRevelado from './TextoRevelado.astro';
import { HERO, ESTUDO } from '../data/site';

// Entrada do hero (CLAUDE.md, seção 5): o texto sobe letra a letra ao carregar; botões e o dado
// do estudo sobem em bloco logo depois.
// No desktop o dado do estudo ocupa a coluna da direita, em destaque. No celular o hero fica
// enxuto: título, uma frase, botões (sem as notinhas) e o dado compacto por último.
---

<section class="hero" id="hero" aria-labelledby="hero-titulo">
  <div class="pagina hero__grade">
    <div class="hero__texto">
      <h1 id="hero-titulo" class="hero__titulo">
        <TextoRevelado texto={HERO.titulo} passoPalavra={30} passoLetra={10} />
      </h1>
      <p class="hero__apoio">
        <TextoRevelado texto={HERO.apoio} inicio={260} passoPalavra={14} passoLetra={6} />
      </p>
      <div class="hero__bloco hero__ctas" style="animation-delay: 420ms">
        <Ctas ordem="diagnostico-primeiro" />
      </div>
    </div>

    <p class="hero__estudo hero__bloco" style="animation-delay: 560ms">
      <strong class="hero__estudo-numero">{ESTUDO.numero}</strong>
      <span class="hero__estudo-texto">{ESTUDO.texto}</span>
      <cite class="hero__estudo-fonte">{ESTUDO.fonte}</cite>
    </p>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(2.5rem, 1.5rem + 5vw, 6.5rem) var(--secao);
  }

  .hero__grade {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: end;
  }

  .hero__texto {
    display: grid;
    gap: 1.75rem;
  }

  .hero__titulo {
    font-size: clamp(2.1rem, 1rem + 2.8vw, 3.5rem);
    max-width: 20ch;
  }

  /* Botões e dado: sobem como bloco. Sem o @keyframes (movimento reduzido) nascem no lugar. */
  .hero__bloco {
    animation: entrar-de-baixo 0.5s ease-out both;
  }

  /* Chamada para o diagnóstico, logo acima dos botões */
  .hero__apoio {
    max-width: 40ch;
    font-size: var(--t-20);
    font-weight: var(--peso-medio);
    margin-bottom: -0.75rem;
  }

  /* Dado do estudo: número grande em cobalto, frase e fonte */
  .hero__estudo {
    display: grid;
    gap: 0.6rem;
    align-content: end;
    padding-top: 1.25rem;
    border-top: 2px solid var(--preto);
  }

  .hero__estudo-numero {
    color: var(--cobalto);
    font-size: clamp(3.5rem, 2rem + 5vw, 6.5rem);
    font-weight: var(--peso-titulo);
    font-stretch: var(--largura-titulo);
    line-height: 0.9;
  }

  .hero__estudo-texto {
    max-width: 26ch;
    font-size: var(--t-20);
    font-weight: var(--peso-medio);
    line-height: 1.35;
  }

  .hero__estudo-fonte {
    color: var(--grafite);
    font-size: var(--t-pequeno);
    font-style: normal;
  }

  @media (max-width: 900px) {
    .hero__grade {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
    }
  }

  /* Celular: menos texto na primeira tela */
  @media (max-width: 760px) {
    .hero__texto {
      gap: 1.25rem;
    }

    .hero__ctas :global(.nota) {
      display: none;
    }

    .hero__ctas :global(.ctas) {
      gap: 0.75rem;
    }

    .hero__ctas :global(.ctas__item),
    .hero__ctas :global(.botao) {
      width: 100%;
      max-width: none;
    }

    .hero__estudo {
      grid-template-columns: auto minmax(0, 1fr);
      column-gap: 1rem;
      align-items: center;
      padding-top: 1rem;
      border-top-width: 1px;
      border-top-color: var(--linha);
    }

    .hero__estudo-numero {
      grid-row: span 2;
      font-size: 2.75rem;
    }

    .hero__estudo-texto {
      font-size: var(--t-16);
    }
  }
</style>
