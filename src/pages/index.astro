---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Dores from '../components/Dores.astro';
import Servicos from '../components/Servicos.astro';
import Demo from '../components/Demo.astro';
import ComoFunciona from '../components/ComoFunciona.astro';
import Time from '../components/Time.astro';
import Faq from '../components/Faq.astro';
import CtaFinal from '../components/CtaFinal.astro';
import Footer from '../components/Footer.astro';
import BarraWhatsapp from '../components/BarraWhatsapp.astro';
---

<Base>
  <Header />
  <main id="conteudo">
    <Hero />
    <Dores />
    <Servicos />
    <Demo />
    <ComoFunciona />
    <Time />
    <Faq />
    <CtaFinal />
  </main>
  <Footer />
  <BarraWhatsapp />
</Base>
